 :root{--bg:#07111f;--bg-soft:#0a1728;--panel:#0d1c30;--panel-2:#10233a;--ink:#f2f6fc;--muted:#9aabc0;--muted-2:#71859e;--line:rgba(163,190,220,.14);--accent:#79c8e8;--accent-strong:#a2e3f6;--max:1160px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:92px}
body{background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif;line-height:1.7;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button,select{font:inherit}
.container{width:min(var(--max),calc(100% - 56px));margin-inline:auto}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.site-header{height:84px;position:sticky;top:0;z-index:50;background:rgba(7,17,31,.88);backdrop-filter:blur(20px);border-bottom:1px solid var(--line)}
.nav-wrap{height:100%;display:flex;align-items:center;justify-content:space-between;gap:28px}
.brand{display:flex;align-items:center;gap:11px;font:800 14px Manrope,sans-serif;letter-spacing:1.7px;white-space:nowrap}
.brand-mark{color:var(--accent);font-size:27px;text-shadow:0 0 22px rgba(121,200,232,.4)}
.brand b{color:var(--accent)}
.brand small{display:block;color:var(--muted-2);font:600 8px "DM Sans",sans-serif;letter-spacing:2.5px;margin-top:-2px}
.nav-links{display:flex;align-items:center;gap:29px}
.nav-links a{font-size:12px;color:#b2bfd0;transition:color .2s}
.nav-links a:hover,.site-footer a:hover{color:var(--accent-strong)}
.nav-actions{display:flex;align-items:center;gap:13px}
.language-select{color:var(--ink);background:#0d1b2d;border:1px solid var(--line);border-radius:7px;padding:9px 10px;font-size:11px;outline:none}
.language-select option{background:#0d1b2d}
.nav-cta{font-size:11px;font-weight:700;border:1px solid rgba(121,200,232,.45);border-radius:6px;padding:10px 15px}
.nav-cta span{color:var(--accent);margin-left:9px}
.menu-toggle{display:none;background:none;border:0;color:var(--ink);font-size:25px}
.hero{min-height:690px;position:relative;overflow:hidden;display:flex;align-items:center;background:radial-gradient(ellipse at 78% 42%,rgba(41,112,158,.18),transparent 38%),linear-gradient(115deg,#07111f 22%,#0a1a2d 100%)}
.hero-grid{position:absolute;inset:0;opacity:.16;background-image:linear-gradient(rgba(151,190,220,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(151,190,220,.12) 1px,transparent 1px);background-size:68px 68px;mask-image:linear-gradient(90deg,transparent,#000)}
.hero-orb{position:absolute;border:1px solid rgba(121,200,232,.13);border-radius:50%;pointer-events:none}
.orb-a{width:520px;height:520px;right:8%;top:9%;box-shadow:0 0 100px rgba(54,133,174,.09),inset 0 0 100px rgba(54,133,174,.06)}
.orb-b{width:340px;height:340px;right:15%;top:22%;border-style:dashed;opacity:.55}
.hero-inner{position:relative;padding:112px 0 125px;z-index:1}
.eyebrow{display:flex;align-items:center;gap:12px;color:var(--accent);font-size:9px;font-weight:700;letter-spacing:2.5px}
.eyebrow-line{width:28px;height:1px;background:var(--accent)}
.hero h1,.section-heading h2,.guidance-inner h2,.download-inner h2{font:700 clamp(43px,6.2vw,76px)/1.12 Manrope,sans-serif;letter-spacing:-3.5px}
.hero h1{margin-top:27px;max-width:760px}
.hero h1 span,.section-heading h2 span,.guidance-inner h2 span,.download-inner h2 span{color:var(--accent)}
.hero-copy{max-width:570px;margin-top:25px;color:#a9b8c9;font-size:15px;line-height:1.9}
.hero-buttons{display:flex;gap:13px;flex-wrap:wrap;margin-top:34px}
.button{min-height:49px;display:inline-flex;align-items:center;justify-content:center;gap:24px;padding:0 20px;border-radius:5px;font-size:11px;font-weight:700;transition:transform .2s,border-color .2s,background .2s}
.button:hover{transform:translateY(-2px)}
.button-primary{background:var(--accent);color:#071522;box-shadow:0 8px 30px rgba(121,200,232,.12)}
.button-primary:hover{background:var(--accent-strong)}
.button-quiet{border:1px solid var(--line);color:#d9e3ef}
.button-quiet:hover{border-color:rgba(121,200,232,.5)}
.hero-meta{display:flex;align-items:center;gap:10px;color:var(--muted-2);font-size:11px;margin-top:54px}
.meta-star{color:var(--accent);font-size:17px}
.hero-index{position:absolute;right:0;bottom:35px;display:flex;align-items:center;gap:12px;color:#71869e;font-size:9px;letter-spacing:1.5px}
.hero-index span:first-child{color:var(--accent)}.hero-index i{width:52px;height:1px;background:var(--line)}
.community-strip{background:#0a1727;border-block:1px solid var(--line);padding:36px 0}
.community-inner{display:flex;align-items:center;justify-content:space-between;gap:35px}
.eyebrow.small{font-size:8px}
.community-inner h2{font:600 22px Manrope,sans-serif;margin-top:8px}
.stat-block{min-width:210px;display:grid;grid-template-columns:auto;justify-items:end}
.stat-block strong{font:700 38px Manrope,sans-serif;color:var(--accent)}
.stat-block>span{font-size:9px;font-weight:700;letter-spacing:1.8px}
.stat-block small{font-size:10px;color:var(--muted-2);margin-top:4px}
.section{padding-block:112px}
.overview-section{display:grid;grid-template-columns:1fr .85fr;gap:100px;align-items:center}
.section-heading h2,.guidance-inner h2{font-size:clamp(36px,4.6vw,55px);letter-spacing:-2.5px;margin-top:22px}
.overview-copy{padding-left:30px;border-left:1px solid rgba(121,200,232,.28)}
.overview-copy p{font-size:14px;color:#c0ccda;line-height:2}
.overview-copy .muted{color:var(--muted-2);font-size:12px;margin-top:15px}
.security-section{padding:110px 0 100px;background:#091727;border-block:1px solid var(--line)}
.centered{text-align:center;max-width:790px;margin:0 auto}
.centered .eyebrow{justify-content:center}
.section-intro{max-width:660px;color:var(--muted);font-size:13px;line-height:1.9;margin-top:18px}
.centered .section-intro{margin-inline:auto}
.security-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:75px;align-items:center;margin-top:65px}
.security-art{height:410px;position:relative;display:grid;place-items:center;overflow:hidden}
.art-ring{position:absolute;border:1px solid rgba(121,200,232,.23);border-radius:50%;transform:rotate(-28deg)}
.ring-one{width:330px;height:190px}.ring-two{width:430px;height:270px;border-style:dashed;opacity:.65}
.art-core{width:105px;height:105px;display:grid;place-items:center;border:1px solid rgba(121,200,232,.6);border-radius:28px 28px 38px 38px;background:linear-gradient(145deg,#17344b,#0b1a2b);color:var(--accent);font-size:47px;box-shadow:0 0 75px rgba(71,159,198,.18)}
.art-label{position:absolute;bottom:24px;text-align:center;font-size:9px;letter-spacing:2px;color:#9bacc0;line-height:2}
.art-label b{color:var(--accent);font-size:8px}
.security-list{border-top:1px solid var(--line)}
.security-item{display:grid;grid-template-columns:42px 1fr;gap:15px;padding:23px 0;border-bottom:1px solid var(--line)}
.item-number{font:600 11px Manrope,sans-serif;color:var(--accent);padding-top:4px}
.security-item h3,.feature-card h3{font:650 16px Manrope,sans-serif;margin-bottom:8px}
.security-item p{font-size:12px;color:var(--muted);line-height:1.9}
.tag-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}
.tag-row span{font-size:9px;color:#b9d9e8;border:1px solid rgba(121,200,232,.2);padding:4px 8px;border-radius:3px}
.status-pill{display:inline-block;margin-top:11px;padding:5px 8px;border:1px solid rgba(226,184,111,.35);border-radius:3px;color:#e5c58d;font-size:8px;font-weight:700;letter-spacing:1px}
.important-note{display:flex;gap:14px;align-items:flex-start;background:rgba(121,200,232,.055);border:1px solid rgba(121,200,232,.16);padding:18px 20px;margin-top:36px;border-radius:5px}
.note-icon{width:19px;height:19px;flex:0 0 19px;border:1px solid var(--accent);border-radius:50%;display:grid;place-items:center;color:var(--accent);font:700 11px Manrope}
.important-note p{font-size:11px;color:#b1c0d0;line-height:1.9}
.features-section .section-intro{margin-top:13px}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:43px}
.feature-card{position:relative;min-height:235px;padding:25px 21px;background:linear-gradient(145deg,#102138,#0b192a);border:1px solid var(--line);border-radius:6px;transition:transform .2s,border-color .2s}
.feature-card:hover{transform:translateY(-4px);border-color:rgba(121,200,232,.4)}
.feature-symbol{color:var(--accent);font-size:26px}
.card-index{position:absolute;right:20px;top:27px;color:#657a91;font-size:9px;letter-spacing:1px}
.feature-card h3{margin-top:32px}
.feature-card>p:last-child{font-size:11px;color:var(--muted);line-height:1.9}
.guidance-section{padding:105px 0;background:#0a1727;border-block:1px solid var(--line)}
.guidance-inner{display:grid;grid-template-columns:1fr 1fr;gap:85px;align-items:center}
.guidance-inner .section-intro{max-width:440px}
.guidance-list{list-style:none;border-top:1px solid var(--line)}
.guidance-list li{position:relative;padding:14px 10px 14px 28px;border-bottom:1px solid var(--line);font-size:12px;color:#c1ccda}
.guidance-list li:before{content:"✓";position:absolute;left:2px;color:var(--accent)}
.disclaimer{margin-top:45px;padding-top:22px;border-top:1px solid var(--line)}
.disclaimer strong{font:600 12px Manrope,sans-serif;color:#d8e5f1}
.disclaimer p{font-size:11px;color:var(--muted-2);margin-top:6px;max-width:850px}
.download-section{padding:110px 0;text-align:center;background:radial-gradient(ellipse at 50% 75%,rgba(35,103,145,.2),transparent 48%),#07111f;border-top:1px solid var(--line)}
.download-inner .eyebrow{justify-content:center}
.download-inner h2{font-size:clamp(38px,5vw,60px);margin-top:20px}
.download-inner>p:not(.eyebrow){color:var(--muted);font-size:13px;margin:16px 0 28px}
.download-button{margin:auto;min-width:220px}
.download-inner small{display:block;color:var(--muted-2);font-size:10px;margin-top:16px}
.site-footer{border-top:1px solid var(--line);padding:27px 0 18px}
.footer-main,.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px}
.footer-main{padding-bottom:23px}
.footer-main>p,.footer-main>a:last-child,.footer-bottom{font-size:10px;color:var(--muted-2)}
.footer-bottom{border-top:1px solid var(--line);padding-top:16px;font-size:9px}
@media(max-width:900px){.nav-links{gap:15px}.nav-links a{font-size:11px}.nav-cta{display:none}.security-layout{gap:35px}.feature-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.container{width:min(var(--max),calc(100% - 38px))}.site-header{height:72px}.nav-wrap{gap:12px}.menu-toggle{display:block;order:3}.nav-actions{margin-left:auto}.nav-links{display:none;position:absolute;top:71px;left:0;right:0;padding:22px 22px 25px;background:#0a1727;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start;gap:17px}.nav-links.open{display:flex}.nav-links a{font-size:13px}.hero{min-height:630px}.hero-inner{padding:95px 0 105px}.hero h1{font-size:clamp(43px,11vw,64px);letter-spacing:-2.7px}.hero-copy{font-size:13px}.orb-a{right:-260px}.orb-b{right:-180px}.hero-index{bottom:23px}.community-inner{align-items:flex-start;flex-direction:column;gap:20px}.stat-block{justify-items:start}.stat-block strong{font-size:34px}.section{padding-block:82px}.overview-section{grid-template-columns:1fr;gap:28px}.overview-copy{padding-left:18px}.section-heading h2,.guidance-inner h2{font-size:clamp(35px,9vw,48px)}.security-section,.guidance-section{padding:82px 0}.security-layout{grid-template-columns:1fr;gap:20px;margin-top:35px}.security-art{height:270px}.ring-one{width:250px;height:145px}.ring-two{width:330px;height:205px}.art-core{width:83px;height:83px;font-size:38px}.guidance-inner{grid-template-columns:1fr;gap:28px}.feature-grid{gap:10px}.feature-card{min-height:220px;padding:20px 16px}.download-section{padding:85px 0}.footer-main{align-items:flex-start;flex-wrap:wrap}.footer-main>p{order:3;width:100%}.footer-bottom{align-items:flex-start;flex-direction:column;gap:5px}}
@media(max-width:420px){.brand{font-size:12px;gap:7px}.brand-mark{font-size:23px}.language-select{padding:8px 7px}.hero-buttons{align-items:stretch;flex-direction:column;max-width:260px}.button{width:100%}.feature-grid{grid-template-columns:1fr}.feature-card{min-height:190px}.feature-card h3{margin-top:20px}.footer-bottom{font-size:8px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
