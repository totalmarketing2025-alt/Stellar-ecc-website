const languageSelect = document.getElementById("languageSelect");
const userCounter = document.getElementById("registeredUsers");
const statsStatus = document.getElementById("statsStatus");
const menuToggle = document.getElementById("menuToggle");
const navLinks = document.getElementById("navLinks");

let statsState = "loading";

function updateStatsStatus(dictionary) {
  if (!statsStatus) return;

  const statusKey = {
    loading: "statsLoading",
    live: "statsLive",
    unavailable: "statsUnavailable"
  }[statsState];

  statsStatus.textContent = dictionary[statusKey];
}

function applyLanguage(language) {
  if (!translations[language]) language = "en";

  const dictionary = translations[language];
  const labels = UI_LABELS[language] || UI_LABELS.en;

  document.documentElement.lang = language;

  document.querySelectorAll("[data-i18n]").forEach(element => {
    const key = element.dataset.i18n;
    if (Object.prototype.hasOwnProperty.call(dictionary, key)) {
      element.textContent = dictionary[key];
    }
  });

  document.querySelectorAll("[data-i18n-html]").forEach(element => {
    const key = element.dataset.i18nHtml;
    if (Object.prototype.hasOwnProperty.call(dictionary, key)) {
      element.innerHTML = dictionary[key];
    }
  });

  document.title = labels.title;

  const metaDescription = document.querySelector('meta[name="description"]');
  const ogTitle = document.querySelector('meta[property="og:title"]');
  const ogDescription = document.querySelector('meta[property="og:description"]');

  if (metaDescription) metaDescription.content = labels.description;
  if (ogTitle) ogTitle.content = labels.ogTitle;
  if (ogDescription) ogDescription.content = labels.ogDescription;

  const brand = document.querySelector(".brand");
  const mainNav = document.querySelector("nav[aria-label]");
  const languageLabel = document.querySelector("#languageSelect");
  const community = document.querySelector(".community-strip");

  if (brand) brand.setAttribute("aria-label", labels.home);
  if (mainNav) mainNav.setAttribute("aria-label", labels.navigation);
  if (languageLabel) languageLabel.setAttribute("aria-label", labels.language);
  if (community) community.setAttribute("aria-label", labels.community);

  if (menuToggle) {
    const isOpen = navLinks && navLinks.classList.contains("open");
    menuToggle.setAttribute("aria-label", isOpen ? labels.menuClose : labels.menuOpen);
  }

  updateStatsStatus(dictionary);

  try {
    localStorage.setItem("stellar-language", language);
  } catch (_) {}
}

let savedLanguage = "en";

try {
  savedLanguage = localStorage.getItem("stellar-language") || "en";
} catch (_) {}

if (!translations[savedLanguage]) savedLanguage = "en";

if (languageSelect) {
  languageSelect.value = savedLanguage;
  languageSelect.addEventListener("change", event => {
    applyLanguage(event.target.value);
  });
}

applyLanguage(savedLanguage);

async function loadRegisteredUsers() {
  if (!userCounter || !statsStatus) return;

  try {
    const response = await fetch(STATS_ENDPOINT, {
      headers: { Accept: "application/json" },
      cache: "no-store"
    });

    if (!response.ok) throw new Error("Statistics endpoint unavailable");

    const data = await response.json();
    const count = data.registeredUsers;

    if (!Number.isSafeInteger(count) || count < 0) {
      throw new Error("Invalid statistics response");
    }

    userCounter.textContent = count.toLocaleString(document.documentElement.lang);
    statsState = "live";
  } catch (_) {
    userCounter.textContent = "—";
    statsState = "unavailable";
  }

  const dictionary = translations[document.documentElement.lang] || translations.en;
  updateStatsStatus(dictionary);
}

if (menuToggle && navLinks) {
  menuToggle.addEventListener("click", () => {
    const open = navLinks.classList.toggle("open");
    menuToggle.setAttribute("aria-expanded", String(open));
    applyLanguage(document.documentElement.lang);
  });

  navLinks.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      navLinks.classList.remove("open");
      menuToggle.setAttribute("aria-expanded", "false");
      applyLanguage(document.documentElement.lang);
    });
  });
}

const yearElement = document.getElementById("year");
if (yearElement) yearElement.textContent = new Date().getFullYear();

loadRegisteredUsers();
setInterval(loadRegisteredUsers, REFRESH_INTERVAL);
